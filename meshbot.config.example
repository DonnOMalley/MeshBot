[meshbot]
; Display name of the bot — shown in welcome/signoff messages and used as the
; command prefix (e.g. @D.A.M.N.bot <command>).
bot_name         = D.A.M.N.bot

; Short description shown alongside the bot name in the web dashboard header.
; Defaults to "Damn Are Mesh Nerds" when omitted.
bot_description  = Damn Are Mesh Nerds

; Channel name to join on startup. Comment out to be prompted at launch.
Channel          = MyChannel

; Hostname or address shown in the console when the web portal starts.
; Defaults to localhost.
WebUrl           = localhost

; Port number the web portal listens on.
; Defaults to 7331.
WebPort          = 7331

; Number of messages sent by the !range command. Min 1, max 10.
RangeTestRequests = 5

; Delay in minutes between each !range test message. Min 1, max 10.
RangeTestDelay    = 1

; Interval in minutes between automatic ZenQuotes API polls.
; Set to 0 or remove to use the default of 60 minutes.
ZenQuotesPollInterval = 60

; When true, command prefix and command names must match exactly as typed.
CaseSensitive    = false

; When true, the built-in commands (ping, test, hello, last) are not registered.
ExcludeOOTB      = false

; When true, skips all node configuration changes on startup and shutdown.
; The device is left exactly as it is — no required settings are applied and
; no original configuration is restored on exit.
NoNodeInit       = false

; Number of days before an inactive node is removed from the node database.
NodeRetentionDays = 30

; Optional passphrase used to encrypt the node database and chat history files.
; Leave blank (or remove) to store data as plain text.
; All nodes sharing history files must use the same key.
EncryptionKey    =

; Print extra diagnostic output to the console.
Verbose          = false

; Hide secondary channels from the chat, dashboard, and settings pages of the web portal.
HideSecondaryChannels = false
